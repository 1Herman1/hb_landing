<footer class="bg-dark text-on-dark py-16 md:py-20">
  <div class="max-w-6xl mx-auto px-5 md:px-8">
    <!-- Top line: copyright -->
    <div class="text-on-dark-muted font-mono text-xs mb-8 md:mb-12">
      H&B team © 2026 · Герман Брызгалов
    </div>

    <!-- Contact tiles grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6">
      <!-- Telegram tile -->
      <a
        href="https://t.me/h_and_b_team"
        class="flex items-center justify-center font-mono font-bold text-base md:text-lg p-4 md:p-6 border rounded-2xl transition-[filter] duration-200 ease-in-out hover:invert"
        style="height: clamp(96px, 15vw, 138px); color: #151515; background: #F5F5F5; border-color: rgba(244, 244, 241, 0.7);"
      >
        Telegram
      </a>

      <!-- Phone tile -->
      <a
        href="tel:+79169655611"
        class="flex items-center justify-center font-mono font-bold text-base md:text-lg p-4 md:p-6 border rounded-2xl transition-[filter] duration-200 ease-in-out hover:invert"
        style="height: clamp(96px, 15vw, 138px); color: #F4F4F1; border-color: rgba(244, 244, 241, 0.7);"
      >
        Позвонить
      </a>

      <!-- Email tile -->
      <a
        href="mailto:gera103546@gmail.com"
        class="flex items-center justify-center font-mono font-bold text-base md:text-lg p-4 md:p-6 border rounded-2xl transition-[filter] duration-200 ease-in-out hover:invert"
        style="height: clamp(96px, 15vw, 138px); color: #F4F4F1; border-color: rgba(244, 244, 241, 0.7);"
      >
        Email
      </a>

      <!-- Top button -->
      <button
        onclick="window.scrollTo({ top: 0, behavior: 'smooth' })"
        class="flex items-center justify-center font-mono font-bold text-base md:text-lg p-4 md:p-6 border rounded-2xl transition-[filter] duration-200 ease-in-out hover:invert"
        style="height: clamp(96px, 15vw, 138px); color: #F4F4F1; border-color: rgba(244, 244, 241, 0.7);"
        aria-label="Наверх"
      >
        Наверх
      </button>
    </div>
  </div>
</footer>
