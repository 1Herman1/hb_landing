---
import SectionTitle from '../ui/SectionTitle.astro';
---

<section id="ai-cases" class="py-24 md:py-32 border-t border-dark-divider">
  <div class="max-w-6xl mx-auto px-5 md:px-8">
    <SectionTitle number="04 /">
      ИИ в <span class="text-accent-on-dark">РЕАЛЬНЫХ</span> задачах
    </SectionTitle>

    <div class="space-y-12">
      {[
        {
          title: 'Поток',
          task: '400 заявок в день письмами',
          solution: 'ИИ читает письмо и вложения, создаёт сделку в CRM, готовит черновик ответа, менеджер проверяет',
          result: '6 недель внедрения',
          metrics: [
            '2 мин вместо 20',
            '+30% заявок тем же штатом',
            'окупилось за 3 месяца',
          ],
        },
        {
          title: 'Советник',
          task: 'Каталог 3 000 средств косметики',
          solution: 'ИИ-консультант: 4 вопроса о коже → персональный набор → ответы 24/7, только каталог компании',
          result: 'Обучен на данных магазина',
          metrics: [
            'конверсия +18%',
            'поддержка −40%',
            'чек +12%',
          ],
        },
      ].map(({ title, task, solution, result, metrics }) => (
        <article class="grid grid-cols-1 md:grid-cols-3 gap-8 pb-12 border-b border-dark-divider last:border-b-0">
          <div class="md:col-span-2">
            <h3 class="text-3xl font-bold font-heading text-on-dark mb-6">{title}</h3>
            <div class="space-y-4">
              <div>
                <h4 class="text-sm font-bold text-on-dark-muted mb-2 uppercase tracking-[0.14em]">ЗАДАЧА</h4>
                <p class="text-on-dark-body max-w-[65ch]">{task}</p>
              </div>
              <div>
                <h4 class="text-sm font-bold text-on-dark-muted mb-2 uppercase tracking-[0.14em]">ЧТО СДЕЛАЛИ</h4>
                <p class="text-on-dark-body max-w-[65ch]">{solution}</p>
              </div>
              <div>
                <h4 class="text-sm font-bold text-on-dark-muted mb-2 uppercase tracking-[0.14em]">РЕЗУЛЬТАТ</h4>
                <p class="text-on-dark-body max-w-[65ch]">{result}</p>
              </div>
            </div>
          </div>

          <div>
            <div class="flex flex-col gap-3">
              {metrics.map((metric) => (
                <div class="px-4 py-3 bg-accent-wash rounded-lg border border-accent-wash-line">
                  <span class="text-accent-on-dark font-bold font-mono text-sm tabular-nums">{metric}</span>
                </div>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
