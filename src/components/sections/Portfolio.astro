---
import { Image } from 'astro:assets';
import SectionTitle from '../ui/SectionTitle.astro';
import Tag from '../ui/Tag.astro';
import { cases } from '../../content/cases';
---

<section id="works" class="py-24 md:py-32 border-t border-dark-divider">
  <div class="max-w-6xl mx-auto px-5 md:px-8">
    <SectionTitle number="03 /">
      <span class="text-accent-on-dark">ИЗБРАННЫЕ</span> работы
    </SectionTitle>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {cases.map((caseItem) => (
        <article class="border border-dark-line rounded-2xl overflow-hidden bg-dark-surface hover:bg-dark-surface-hover hover:border-dark-line-strong transition-[background-color,border-color] duration-200">
          <!-- Обложка ВСЕГДА видна, вне details -->
          <div class="aspect-[16/10] overflow-hidden rounded-t-xl relative group cursor-pointer">
            <!-- Image -->
            <Image
              src={caseItem.image}
              alt={caseItem.name}
              width={1600}
              format="webp"
              loading="lazy"
              decoding="async"
              sizes="100vw"
              class="w-full h-full object-cover"
              style="filter: brightness(.72) contrast(1.1);"
            />

            <!-- Tags overlay top-left -->
            <div class="absolute top-3 left-3 flex flex-wrap gap-2">
              {caseItem.tags.map((tag) => (
                <span class="inline-flex px-3 py-1.5 rounded-full font-mono uppercase text-xs font-medium" style="background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.7); backdrop-filter: blur(10px); color: white;">
                  {tag}
                </span>
              ))}
            </div>

            <!-- Read case button bottom-left (trigger для details) -->
            <button
              class="absolute bottom-5 left-5 inline-flex items-center justify-center px-6 h-[46px] rounded-full font-mono font-bold text-sm cursor-pointer transition-colors duration-300 group-hover:text-white"
              style="background: #F5F5F5; color: #090909;"
              onclick="this.closest('article').querySelector('details').open = !this.closest('article').querySelector('details').open"
            >
              Читать кейс
            </button>
          </div>

          <!-- Название кейса ВСЕГДА видно, вне details -->
          <div class="p-8">
            <h3 class="text-2xl font-bold font-heading text-on-dark mb-6">{caseItem.name}</h3>
          </div>

          <!-- Details с содержимым - раскрывается по клику на пилюлю -->
          <details class="group">
            <summary style="display: none;"></summary>
            <div class="px-8 pb-8 space-y-4 text-on-dark-body border-t border-dark-line">
              <div>
                <h4 class="font-bold text-sm text-on-dark-muted mb-2 font-mono uppercase tracking-[0.14em]">Задача</h4>
                <p class="leading-relaxed">{caseItem.task}</p>
              </div>
              <div>
                <h4 class="font-bold text-sm text-on-dark-muted mb-2 font-mono uppercase tracking-[0.14em]">Решение</h4>
                <p class="leading-relaxed">{caseItem.solution}</p>
              </div>
              <div>
                <h4 class="font-bold text-sm text-on-dark-muted mb-2 font-mono uppercase tracking-[0.14em]">Результат</h4>
                <p class="leading-relaxed">{caseItem.result}</p>
              </div>
            </div>
          </details>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  details {
    list-style: none;
  }

  details::-webkit-details-marker {
    display: none;
  }

  summary {
    display: inline-flex;
    position: relative;
    overflow: hidden;
  }

  summary::before {
    content: '';
    position: absolute;
    inset: 0;
    background: #F97316;
    transform: translateY(100%);
    transition: transform 0.4s ease;
    z-index: -1;
  }

  summary:hover::before {
    transform: translateY(0);
  }
</style>
