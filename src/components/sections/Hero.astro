---
import Button from '../ui/Button.astro';

const BASE_URL = import.meta.env.BASE_URL;
---

<section class="min-h-screen bg-dark text-on-dark flex items-center justify-center py-16 overflow-x-clip">
  <div class="max-w-6xl mx-auto px-4 md:px-6 w-full flex flex-col items-center text-center">
    <!-- Top info line -->
    <div class="w-full flex items-center justify-between mb-12 text-sm md:text-base">
      <div class="flex items-center gap-2 font-medium">
        <span class="text-accent-on-dark">•</span>
        <span class="text-on-dark-muted">Герман Брызгалов</span>
      </div>
      <a href="https://t.me/gera103546" target="_blank" rel="noopener noreferrer" class="inline-flex items-center min-h-[44px] text-on-dark-muted hover:text-accent-on-dark transition-colors duration-200">
        {'{'} Написать в Telegram {'}'}
      </a>
    </div>

    <!-- Hero video with floating chips -->
    <div class="relative mb-12 mx-auto w-full max-w-[760px]">
      <!-- Video container with mask -->
      <div class="relative mx-auto" style="max-width: 440px;">
        <video
          id="hero-video"
          muted
          loop
          playsinline
          preload="metadata"
          poster={`${BASE_URL}media/hero/germes.jpg`}
          aria-hidden="true"
          class="w-full h-auto object-cover"
          style="max-height: 560px; aspect-ratio: 1; mask-image: radial-gradient(ellipse 46% 52% at 50% 42%, #000 34%, rgba(0,0,0,.6) 62%, transparent 82%); -webkit-mask-image: radial-gradient(ellipse 46% 52% at 50% 42%, #000 34%, rgba(0,0,0,.6) 62%, transparent 82%);"
        >
          <source src={`${BASE_URL}media/hero/germes.mp4`} type="video/mp4" />
        </video>
      </div>

      <!-- Floating chips -->
      <div class="absolute left-0 top-[22%] z-10 -translate-y-1/2 md:translate-y-0 hidden md:block">
        <div class="px-4 py-2 rounded-full bg-chip-bg border border-chip-border backdrop-blur-md text-[13px] font-medium text-on-dark-muted whitespace-nowrap">
          Сайты и сервисы
        </div>
      </div>

      <div class="absolute right-0 top-[12%] z-10 hidden md:block">
        <div class="px-4 py-2 rounded-full bg-chip-bg border border-chip-border backdrop-blur-md text-[13px] font-medium text-on-dark-muted whitespace-nowrap">
          SaaS
        </div>
      </div>

      <div class="absolute right-[6%] bottom-[14%] z-10">
        <div class="px-4 py-2 rounded-full bg-chip-bg border border-chip-border backdrop-blur-md text-[13px] font-medium text-on-dark-muted whitespace-nowrap">
          ИИ-решения
        </div>
      </div>
    </div>

    <!-- Facts line -->
    <div class="text-on-dark-muted text-sm mb-8 md:mb-12">
      8+ лет · 40+ проектов · Москва
    </div>

    <!-- Name heading - full width -->
    <div style="width: calc(100vw - 48px);" class="mx-[calc(50%-50vw)] mb-8 mt-8">
      <h1 class="text-[clamp(2.25rem,8vw,10rem)] font-heading font-bold leading-[0.86] tracking-[-0.03em] mb-2">
        <span class="block text-on-dark">ГЕРМАН БРЫЗГАЛОВ</span>
        <span class="block text-accent-on-dark">РАЗРАБОТКА И ИИ</span>
      </h1>
    </div>

    <!-- Contact button -->
    <div class="mt-12 mb-6">
      <button
        id="hero-contact-btn"
        class="w-16 h-16 md:w-20 md:h-20 rounded-full bg-on-dark text-dark flex items-center justify-center hover:bg-white transition-colors duration-200 ease-out focus:outline-none focus:ring-2 focus:ring-accent-on-dark focus:ring-offset-2 focus:ring-offset-dark"
        aria-label="Связаться"
      >
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="12" y1="5" x2="12" y2="19"></line>
          <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
      </button>
    </div>

    <!-- Call to action text -->
    <p class="text-on-dark-muted text-sm max-w-sm">
      Нажмите на кнопку, чтобы связаться со мной
    </p>
  </div>
</section>

<script>
  // Check prefers-reduced-motion before autoplaying
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const heroVideo = document.getElementById('hero-video') as HTMLVideoElement;

  if (!prefersReducedMotion) {
    // Hero video autoplays immediately since it's visible from the start
    heroVideo?.play().catch(() => {
      // Gracefully handle play() rejection (browser autoplay policies)
    });
  }

  // Contact button opens dialog
  const heroBtn = document.getElementById('hero-contact-btn');
  heroBtn?.addEventListener('click', () => {
    window.dispatchEvent(new Event('open-contact-dialog'));
  });
</script>
