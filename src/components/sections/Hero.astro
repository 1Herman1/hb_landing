---
import Button from '../ui/Button.astro';

const BASE_URL = import.meta.env.BASE_URL;
---

<section class="relative min-h-[100svh] bg-[#010101] text-white overflow-hidden flex flex-col items-center justify-center">
  <!-- Top line: Sun icon + Name on the left, Telegram link on the right (absolute OVER the video zone) -->
  <div class="absolute top-10 left-0 right-0 z-50 flex items-center justify-between px-4 md:px-6">
    <!-- Left: Sun icon + Герман Брызгалов -->
    <div class="flex items-center gap-2 md:gap-2">
      <!-- Sun icon SVG 22×22 -->
      <svg width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg" class="flex-shrink-0">
        <!-- Circle -->
        <circle cx="11" cy="11" r="4.5" fill="#F97316"/>
        <!-- 8 rays -->
        <line x1="11" y1="1" x2="11" y2="2.5" stroke="#F97316" stroke-width="1.5" stroke-linecap="round"/>
        <line x1="11" y1="19.5" x2="11" y2="21" stroke="#F97316" stroke-width="1.5" stroke-linecap="round"/>
        <line x1="1" y1="11" x2="2.5" y2="11" stroke="#F97316" stroke-width="1.5" stroke-linecap="round"/>
        <line x1="19.5" y1="11" x2="21" y2="11" stroke="#F97316" stroke-width="1.5" stroke-linecap="round"/>
        <!-- Diagonal rays -->
        <line x1="3.5" y1="3.5" x2="4.78" y2="4.78" stroke="#F97316" stroke-width="1.5" stroke-linecap="round"/>
        <line x1="17.22" y1="17.22" x2="18.5" y2="18.5" stroke="#F97316" stroke-width="1.5" stroke-linecap="round"/>
        <line x1="18.5" y1="3.5" x2="17.22" y2="4.78" stroke="#F97316" stroke-width="1.5" stroke-linecap="round"/>
        <line x1="4.78" y1="17.22" x2="3.5" y2="18.5" stroke="#F97316" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
      <!-- Name: Герман Брызгалов, mono 500 -->
      <span class="font-mono font-medium text-white" style="font-size: clamp(12px, 1.17vw, 16.8px); line-height: 1.2;">
        Герман Брызгалов
      </span>
    </div>

    <!-- Right: Telegram link -->
    <a
      href="https://t.me/gera103546"
      target="_blank"
      rel="noopener noreferrer"
      class="font-mono font-medium text-white hover:text-[#F97316] transition-colors duration-200 inline-flex items-center justify-center min-h-[44px] flex-shrink-0"
      style="font-size: clamp(12px, 1.17vw, 16.8px); line-height: 1.2;"
    >
      {'{'} Написать в Telegram {'}'}
    </a>
  </div>

  <!-- Main content container: flex column to control vertical rhythm -->
  <div class="relative w-full flex flex-col items-center justify-center" style="flex: 1; gap: 0;">
    <!-- Video zone container: max-w-[1200px], positioning anchor for chips -->
    <div
      class="relative"
      style="
        width: 100%;
        max-width: 1200px;
        margin-left: auto;
        margin-right: auto;
        padding: 0 16px;
        height: clamp(300px, 36vw, 518px);
        display: flex;
        align-items: center;
        justify-content: center;
      "
    >
      <!-- Video container - centered -->
      <div style="width: clamp(300px, 36vw, 518px); aspect-ratio: 1; display: flex; align-items: center; justify-content: center;">
        <video
          id="hero-video"
          muted
          loop
          playsinline
          preload="metadata"
          poster={`${BASE_URL}media/hero/germes.jpg`}
          aria-hidden="true"
          class="w-full h-full object-cover"
          style="mask-image: radial-gradient(ellipse 46% 52% at 50% 42%, #000 34%, rgba(0,0,0,.6) 62%, transparent 82%); -webkit-mask-image: radial-gradient(ellipse 46% 52% at 50% 42%, #000 34%, rgba(0,0,0,.6) 62%, transparent 82%);"
        >
          <source src={`${BASE_URL}media/hero/germes.mp4`} type="video/mp4" />
        </video>
      </div>

      <!-- Floating chips - positioned absolutely from the 1200px container -->
      <!-- Chip 1: "Сайты и сервисы" - left 57.75% top 124px (desktop) / 115px (mobile ~390) -->
      <div class="absolute pointer-events-auto" style="left: 57.75%; top: clamp(115px, 12.4vw, 124px); transform: translateX(-50%);">
        <div class="px-4 py-2 rounded-full" style="height: clamp(34px, 3.17vw, 46px); background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.7); backdrop-filter: blur(20px); font-family: var(--font-mono); font-weight: 400; color: white; font-size: clamp(12px, 1.17vw, 16.8px); display: inline-flex; align-items: center; white-space: nowrap; line-height: 1.2;">
          Сайты и сервисы
        </div>
      </div>

      <!-- Chip 2: "SaaS" - left 35.25% top 239px (desktop) / 216px (mobile) -->
      <div class="absolute pointer-events-auto" style="left: 35.25%; top: clamp(216px, 23.9vw, 239px); transform: translateX(-50%);">
        <div class="px-4 py-2 rounded-full" style="height: clamp(34px, 3.17vw, 46px); background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.7); backdrop-filter: blur(20px); font-family: var(--font-mono); font-weight: 400; color: white; font-size: clamp(12px, 1.17vw, 16.8px); display: inline-flex; align-items: center; white-space: nowrap; line-height: 1.2;">
          SaaS
        </div>
      </div>

      <!-- Chip 3: "ИИ-решения" - left 54.8% top 364px (desktop) / 309px (mobile) -->
      <div class="absolute pointer-events-auto" style="left: 54.8%; top: clamp(309px, 36.4vw, 364px); transform: translateX(-50%);">
        <div class="px-4 py-2 rounded-full" style="height: clamp(34px, 3.17vw, 46px); background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.7); backdrop-filter: blur(20px); font-family: var(--font-mono); font-weight: 400; color: white; font-size: clamp(12px, 1.17vw, 16.8px); display: inline-flex; align-items: center; white-space: nowrap; line-height: 1.2;">
          ИИ-решения
        </div>
      </div>
    </div>

    <!-- Facts line (overlaps video slightly) -->
    <div
      class="font-mono font-medium text-white text-center flex items-center justify-center relative"
      style="
        font-size: clamp(14px, 1.5vw, 21.6px);
        line-height: 1.2;
        gap: clamp(16px, 1.67vw, 30px);
        margin-top: clamp(-6px, -0.6vw, -36px);
      "
    >
      <span>опыт 8+ лет</span>
      <span>Москва</span>
    </div>

    <!-- H1 Heading (tight margin after facts) -->
    <h1
      class="font-heading uppercase text-center"
      style="
        font-size: clamp(45px, 6.4vw, 92px);
        line-height: 1.0;
        letter-spacing: 0;
        margin-top: clamp(12px, 1.37vw, 22px);
        max-width: 1200px;
        width: 100%;
        padding: 0 16px;
      "
    >
      <span class="block" style="color: #F5F5F5; white-space: nowrap;">ГЕРМАН БРЫЗГАЛОВ</span>
      <span class="block" style="color: #F97316; white-space: nowrap;">РАЗРАБОТКА И ИИ</span>
    </h1>

    <!-- Contact button (below heading) -->
    <button
      id="hero-contact-btn"
      class="rounded-full transition-colors duration-200 flex items-center justify-center flex-shrink-0"
      style="
        width: clamp(60px, 5.83vw, 84px);
        height: clamp(60px, 5.83vw, 84px);
        background-color: #F5F5F5;
        color: #010101;
        margin-top: clamp(18px, 2.08vw, 36px);
      "
      aria-label="Связаться"
    >
      <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <line x1="12" y1="5" x2="12" y2="19"></line>
        <line x1="5" y1="12" x2="19" y2="12"></line>
      </svg>
    </button>

    <!-- Call to action text (bottom of viewport) -->
    <p
      class="font-mono font-medium text-white text-center"
      style="
        font-size: clamp(12px, 1.17vw, 16.8px);
        line-height: 1.55;
        max-width: 234px;
        margin-top: clamp(9px, 0.9vw, 18px);
      "
    >
      Нажмите на кнопку, чтобы связаться со мной
    </p>
  </div>
</section>

<script>
  // Check prefers-reduced-motion before autoplaying
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const heroVideo = document.getElementById('hero-video') as HTMLVideoElement;

  if (!prefersReducedMotion) {
    heroVideo?.play().catch(() => {
      // Gracefully handle play() rejection
    });
  }

  // Contact button opens dialog
  const heroBtn = document.getElementById('hero-contact-btn');
  heroBtn?.addEventListener('click', () => {
    window.dispatchEvent(new Event('open-contact-dialog'));
  });

  // Character-by-character animation for h1
  if (!prefersReducedMotion) {
    const h1 = document.querySelector('h1');
    if (h1) {
      let globalCharIndex = 0;

      // Process each span.block (each line) separately to preserve color
      h1.querySelectorAll('span.block').forEach((lineSpan) => {
        const text = lineSpan.textContent;
        lineSpan.textContent = ''; // Clear only this line's text

        text.split('').forEach((char) => {
          const charSpan = document.createElement('span');
          charSpan.textContent = char;
          charSpan.className = 'char-in';
          charSpan.style.display = 'inline';
          charSpan.style.animationDelay = `${globalCharIndex * 26}ms`;
          charSpan.style.color = 'inherit'; // Inherit from parent span.block
          lineSpan.appendChild(charSpan);
          globalCharIndex++;
        });
      });
    }
  }
</script>

<style>
  @keyframes char-in {
    from {
      opacity: 0;
      filter: blur(8px);
    }
    to {
      opacity: 1;
      filter: blur(0);
    }
  }

  :global(.char-in) {
    animation: char-in 0.5s ease forwards;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.char-in) {
      animation: none;
      opacity: 1;
      filter: none;
    }
  }
</style>
