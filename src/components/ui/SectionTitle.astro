---
interface Props {
  number: string;
  title: string;
  class?: string;
}

const { number, title, class: className = '' } = Astro.props;
---

<div class={`mb-12 text-center ${className}`}>
  <div class="text-on-dark-faint font-mono font-medium mb-2 text-sm tracking-[0.14em] uppercase">
    {number}
  </div>
  <h2 class="text-[clamp(34px,4.5vw,65px)] font-bold font-heading text-on-dark leading-[1.0] mx-auto max-w-4xl section-title">
    <slot />
  </h2>
</div>

<script>
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting && !entry.target.hasAttribute('data-animated')) {
        entry.target.setAttribute('data-animated', 'true');

        if (!prefersReducedMotion) {
          const titleEl = entry.target as HTMLElement;
          const text = titleEl.textContent || '';
          titleEl.textContent = '';

          let charIndex = 0;
          text.split('').forEach((char) => {
            const span = document.createElement('span');
            span.textContent = char;
            span.className = 'section-char';
            span.style.display = 'inline-block';
            span.style.animationDelay = `${charIndex * 26}ms`;
            titleEl.appendChild(span);
            charIndex++;
          });
        }
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.1 });

  document.querySelectorAll('.section-title').forEach(el => {
    observer.observe(el);
  });
</script>

<style>
  @keyframes section-char-in {
    from {
      opacity: 0;
      filter: blur(20px);
    }
    to {
      opacity: 1;
      filter: blur(0);
    }
  }

  :global(.section-char) {
    animation: section-char-in 0.6s ease forwards;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.section-char) {
      animation: none;
      opacity: 1;
      filter: none;
    }
  }
</style>
