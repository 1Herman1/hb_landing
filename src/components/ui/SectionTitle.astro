---
interface Props {
  number: string;
  title: string;
  class?: string;
}

const { number, title, class: className = '' } = Astro.props;
---

<div class={`mb-12 ${className}`}>
  <div class="text-on-dark-faint font-medium mb-2 text-base tracking-[0.14em] uppercase">
    {number}
  </div>
  <h2 class="text-[clamp(2rem,4vw,3.25rem)] font-bold font-heading text-on-dark max-w-3xl leading-[1.05]">
    {title}
  </h2>
</div>
